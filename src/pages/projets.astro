---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pill from '../components/Pill.astro';
import ProjectCard from "../components/ProjectCard.astro";
import { projets } from "../data/projets";


const projetsVisibles = projets.filter((projet) => !projet.draft);

const practices: { title: string; text: string; tone: string; icon: IconName }[] = [
  {
    title: "Images taillées au gramme près",
    text: "Formats modernes (WebP/AVIF), images redimensionnées selon l’écran : on n’envoie jamais plus que nécessaire. Les visuels restent éclatants, sans jamais ramer.",
    tone: "lime",
    icon: "image",
  },
  {
    title: "Peu de scripts tiers",
    text: "Pas de méga-scripts de suivi ni de dépendances tentaculaires. Du HTML sémantique et du CSS léger, taillés sur mesure pour une page qui charge vite.",
    tone: "mint",
    icon: "code",
  },
  {
    title: "Hébergement choisi avec soin",
    text: "Je t’aide à choisir un hébergeur responsable et transparent, plutôt que de te promettre la lune. On regarde ensemble ce qui est vérifiable.",
    tone: "sky",
    icon: "leaf",
  },
];

const icons = {
  image: '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="1.6"/><path d="m21 15-5-5L5 21"/>',
  code: '<path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m13.5 6-3 12"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 4 13c0-6 6-9 16-9 0 10-3 16-9 16Z"/><path d="M4 21c3-6 6-9 10-11"/>',
};

type IconName = keyof typeof icons;
---

<BaseLayout
  title="Projets"
  description="Les réalisations de Popup Studio : un aperçu de sites légers, singuliers et pensés pour consommer peu. Découvre SABOOM."
  ctaTitle="Envie de voir ton activité sur cette page avec un score A ?"
>
  <section class="hero container">
    <Pill tone="lime">Nos bébés numériques</Pill>
    <h1>Des créations engagées, légères et singulières</h1>
    <p class="hero__lead">
      Ici, pas de sites obèses de 15 Mo ni de templates froids. Que de l’artisanal, ultra-léger et calibré pour convertir sans réchauffer la banquise.
    </p>
  </section>

  <section class="container section">
    <article class="projects-grid">
  {projetsVisibles.map((projet) => (
    <ProjectCard {...projet} />
  ))}
</article>
  </section>

<section class="capot container">
  <div class="capot__inner">
    <h2>L’éco-conception en pratique sur nos projets</h2>
    <p class="capot__lead">
      Pas de greenwashing : voici comment nos sites chargent en un clin d’œil sans ruiner ta facture énergétique ni celle de la planète.
    </p>

    <div class="practices">
      {practices.map((p) => (
        <article class="practice">
          <span class={`practice__icon practice__icon--${p.tone}`} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
          </span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
</BaseLayout>

<style>
  h2 { font-size: 40px; line-height: 48px; font-weight: 700; letter-spacing: -0.02em; }
  .chip {
    padding: var(--space-xs) 0.75rem; background: var(--surface-low);
    border: 1.5px solid var(--border-passive); border-radius: var(--radius-full);
    font-size: 12px; font-weight: 600;
  }

  .section { padding-block: var(--space-lg) var(--space-xl); }
  .section__lead { margin-top: var(--space-sm); max-width: 60ch; color: var(--on-surface-variant); }

  .hero { padding-block: 4rem var(--space-lg); }
  .hero h1 {
    max-width: 22ch; margin: var(--space-md) 0;
    font-size: 56px; line-height: 64px; font-weight: 800; letter-spacing: -0.03em;
  }
  .hero__lead { max-width: 56ch; font-size: 18px; line-height: 28px; color: var(--on-surface-variant); }

  .project {
    display: grid; grid-template-columns: 1.2fr 1fr;
    background: var(--white); border: 1.5px solid var(--border-passive);
    border-radius: var(--radius-lg); overflow: hidden;
  }
  .project img { width: 100%; height: 100%; object-fit: cover; background: var(--surface-container); }
  .project__body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding: var(--space-xl) var(--space-lg); }
  .project__body h2 { font-size: 40px; }
  .project__metrics { display: flex; gap: var(--space-lg); flex-wrap: wrap; }
  .project__metrics dt { font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--on-surface-variant); }
  .project__metrics dd { margin: 0; font-weight: 700; font-size: 18px; }
  .project__tags { display: flex; gap: var(--space-sm); flex-wrap: wrap; }

  .band { padding-block: var(--space-xl); background: var(--surface-low); }
  .practices { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); margin-top: var(--space-lg); }
  .practice {
    padding: var(--space-lg); background: var(--white);
    border: 1.5px solid var(--border-passive); border-top: 4px solid var(--tone);
    border-radius: var(--radius-lg);
  }
  .practice__dot { display: block; width: 28px; height: 28px; margin-bottom: var(--space-md); background: var(--tone); border-radius: var(--radius); }
  .practice h3 { font-size: 20px; line-height: 28px; }
  .practice p { margin-top: var(--space-sm); font-size: 14px; line-height: 22px; color: var(--on-surface-variant); }

  @media (max-width: 64rem) { .project, .practices { grid-template-columns: 1fr; } }
  @media (max-width: 48rem) {
    .hero h1 { font-size: 38px; line-height: 44px; letter-spacing: -0.02em; }
    h2, .project__body h2 { font-size: 28px; line-height: 36px; }
  }
  .capot__inner {
  background: var(--surface-low);
  border-radius: 1.5rem;
  padding: var(--space-xl);
}

.capot__lead {
  max-width: 44ch;
  margin: 0;
  font-size: 14px;
  line-height: 1.6;
}

.practices {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--gutter);
  margin-top: var(--space-xl);
}

.practice {
  background: #fff;
  border-radius: 1rem;
  padding: var(--space-lg);
}

.practice h3 {
  font-size: 20px;
  line-height: 28px;
  color: #1b4332;
  margin: var(--space-md) 0 var(--space-sm);
}

.practice p {
  font-size: 14px;
  line-height: 20px;
  margin: 0;
}

.practice__icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 0.75rem;
  color: #1b4332;
}
.practice__icon--lime { background: #c8e676; }
.practice__icon--mint { background: #c1ecd4; }
.practice__icon--sky  { background: #acd6f6; }

@media (max-width: 64rem) {
  .practices { grid-template-columns: 1fr; }
  .capot__inner { padding: var(--space-lg); }
}
</style>