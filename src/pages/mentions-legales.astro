---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pill from "../components/Pill.astro";
import Button from "../components/Button.astro";

const contents = [
  { id: "editeur", label: "Édition du site" },
  { id: "hebergement", label: "Hébergement & circuit court" },
  { id: "donnees", label: "Données & zéro mouchard" },
  { id: "propriete", label: "Propriété & logiciels libres" },
  { id: "accessibilite", label: "Accessibilité (WCAG 2.1)" },
];
---
<BaseLayout showCta={false} title="Mentions légales" description="Mentions légales de Popup Studio : éditeur, hébergement, données personnelles, propriété et accessibilité.">
  <section class="container hero" aria-labelledby="legal-title">
    <Pill tone="lime">Transparence & juridique</Pill>
    <h1 id="legal-title">Mentions légales & respect de ta vie privée</h1>
    <p class="intro">Parce qu’un texte de loi peut aussi se lire sans aspirine, sans clauses en corps 4 et surtout sans mouchard sournois sous le paillasson. Les informations à compléter sont signalées clairement — pas d’invention en petits caractères.</p>
    <div class="certification"><div class="cert-icon" aria-hidden="true">✓</div><div><strong>Hygiène numérique : les faits d’abord</strong><p>Les outils actifs, les cookies et les données réellement collectées restent à vérifier avant toute promesse de « zéro traceur ».</p></div><span class="cert-tag">À vérifier avant publication</span></div>
    <p class="provisional"><strong>Chiffres provisoires — à ajuster.</strong> Les valeurs chiffrées des maquettes sont fictives et ne constituent ni mesure ni certification.</p>
  </section>

  <div class="container layout">
    <aside class="aside">
      <nav class="toc" aria-label="Sommaire clair"><p class="toc-title"><span aria-hidden="true">☷</span> Sommaire clair</p><ol>{contents.map((item,index)=><li><a href={`#${item.id}`}><span>0{index+1}.</span>{item.label}</a></li>)}</ol></nav>
      <blockquote class="quote"><span class="quote-kicker">La règle d’or d’Axel</span><p>« Si une phrase est impossible à comprendre, elle mérite une deuxième version. Ici, chaque mot doit dire clairement ce qu’il veut dire. »</p><span class="quote-sign">Axel · Nantes</span></blockquote>
    </aside>

    <div class="content">
      <section id="editeur" class="card" aria-labelledby="editeur-title"><div class="card-heading"><span class="number">01</span><div><p class="eyebrow">Identification légale</p><h2 id="editeur-title">Éditeur du site</h2></div></div>
        <p>Le site <strong>popupstudio.fr</strong> est édité par Axel, créateur de Popup Studio, studio indépendant basé à Nantes, en France.</p>
        <div class="info-grid"><div class="info-tile"><span>Nom commercial</span><strong>Popup Studio</strong></div><div class="info-tile"><span>Éditeur & forme juridique</span><strong>[À COMPLÉTER — identité et statut juridique]</strong></div><div class="info-tile"><span>Adresse professionnelle</span><strong>[À COMPLÉTER — adresse légale]</strong></div><div class="info-tile"><span>Immatriculation</span><strong>SIRET : [À COMPLÉTER]</strong></div><div class="info-tile"><span>Direction de publication</span><strong>Axel [À COMPLÉTER — nom légal]</strong></div><div class="info-tile"><span>Contact</span><strong>[À COMPLÉTER — adresse e-mail]</strong></div></div>
        <p class="callout"><strong>Une info manque&nbsp;?</strong> C’est volontairement signalé. Les mentions doivent être complétées avant publication, pas garnies au hasard.</p>
      </section>

      <section id="hebergement" class="card" aria-labelledby="hebergement-title"><div class="card-heading"><span class="number">02</span><div><p class="eyebrow">Infrastructure & circuit court</p><h2 id="hebergement-title">Hébergement & circuit court</h2></div></div>
        <p>Les caractéristiques de l’hébergement dépendent du prestataire réellement choisi. Pas de promesse d’énergie verte, de proximité ou de certification sans justificatif consultable.</p>
        <div class="hosting-grid"><article class="hosting-tile"><span class="tile-icon" aria-hidden="true">↯</span><h3>Énergie & refroidissement</h3><p><strong>[À COMPLÉTER]</strong> Fournisseur, mix énergétique, garanties d’origine et modalités de refroidissement à confirmer auprès de l’hébergeur.</p><span class="mini-tag">Données à vérifier</span></article><article class="hosting-tile"><span class="tile-icon" aria-hidden="true">⌖</span><h3>Localisation des serveurs</h3><p><strong>[À COMPLÉTER]</strong> Pays et centres de données à confirmer. Les mentions ISO et l’indicateur PUE ne seront publiés qu’avec des sources valides.</p><span class="mini-tag">Aucune certification affirmée</span></article></div>
        <dl class="facts"><div><dt>Nom et raison sociale</dt><dd>[À COMPLÉTER]</dd></div><div><dt>Adresse & contact</dt><dd>[À COMPLÉTER]</dd></div><div><dt>Localisation des données</dt><dd>[À COMPLÉTER — à confirmer]</dd></div></dl>
      </section>

      <section id="donnees" class="card" aria-labelledby="donnees-title"><div class="card-heading"><span class="number">03</span><div><p class="eyebrow">Vie privée & données personnelles</p><h2 id="donnees-title">Zéro cookie, zéro mouchard&nbsp;?</h2></div></div>
        <div class="callout green"><strong>Pas de promesse avant vérification.</strong> L’inventaire technique des cookies, journaux, formulaires et services tiers doit être réalisé avant d’affirmer qu’aucun traceur n’est déposé.</div>
        <h3>Les seules données que nous traiterons</h3><p>Si tu écris à Axel, les données et leur usage doivent être décrits selon le fonctionnement réel du formulaire ou de la messagerie. À compléter avant mise en ligne :</p>
        <ul class="checklist"><li><span>✓</span><div><strong>Finalité</strong><p>[À COMPLÉTER — par exemple répondre à ta demande, si c’est bien le cas]</p></div></li><li><span>✓</span><div><strong>Durée de conservation</strong><p>[À COMPLÉTER — durée définie selon les besoins et obligations applicables]</p></div></li><li><span>✓</span><div><strong>Partage des données</strong><p>[À COMPLÉTER — destinataires et sous-traitants réels]</p></div></li><li><span>✓</span><div><strong>Cookies et autres traceurs</strong><p>[À COMPLÉTER — après audit des outils réellement actifs]</p></div></li></ul>
        <div class="rights"><div><strong>Tes droits, sans détour</strong><p>Accès, rectification, effacement, limitation ou opposition : les modalités et le contact restent à compléter avant publication. Tu peux aussi consulter la <a href="https://www.cnil.fr/" target="_blank" rel="noopener noreferrer">CNIL</a>.</p></div><Button href="/contact" variant="pop">Écrire à Axel</Button></div>
      </section>

      <section id="propriete" class="card" aria-labelledby="propriete-title"><div class="card-heading"><span class="number">04</span><div><p class="eyebrow">Droits d’auteur & esprit libre</p><h2 id="propriete-title">Propriété & esprit libre</h2></div></div>
        <p>Sauf mention contraire, les contenus originaux de ce site — textes, éléments graphiques et identité Popup Studio — sont protégés par le droit de la propriété intellectuelle. Pour les réutiliser, demande d’abord l’autorisation à l’éditeur.</p>
        <p>Les contenus et outils de tiers restent soumis à leurs licences respectives. Pour un projet livré, les droits et les fichiers remis sont ceux précisés dans le devis ou le contrat correspondant.</p>
        <div class="callout green"><strong>Pas de prise d’otage technique.</strong> Les droits sur le code et les modalités de remise sont définis dans le devis ou le contrat du projet — lis-le avant signature, et pose tes questions.</div>
      </section>

      <section id="accessibilite" class="card" aria-labelledby="accessibilite-title"><div class="card-heading"><span class="number">05</span><div><p class="eyebrow">Inclusion universelle</p><h2 id="accessibilite-title">Accessibilité (RGAA / WCAG 2.1)</h2></div></div>
        <p>Un site sobre doit aussi rester utilisable par le plus grand nombre. Popup Studio vise des contenus lisibles, une navigation au clavier et une structure compréhensible ; cela ne vaut ni audit ni déclaration de conformité.</p>
        <div class="access-grid"><article><span aria-hidden="true">◐</span><h3>Contrastes lisibles</h3><p>À mesurer et vérifier sur les pages et états interactifs.</p></article><article><span aria-hidden="true">⌨</span><h3>Navigation clavier</h3><p>À tester sur l’ensemble des parcours et composants.</p></article><article><span aria-hidden="true">⌘</span><h3>HTML sémantique</h3><p>À contrôler avec des technologies d’assistance.</p></article></div>
        <dl class="facts"><div><dt>État de conformité</dt><dd>[À COMPLÉTER — après évaluation]</dd></div><div><dt>Contact en cas de difficulté</dt><dd>[À COMPLÉTER — adresse e-mail]</dd></div></dl>
      </section>
    </div>
  </div>

  </BaseLayout>
<style>
.hero{padding-block:4.2rem 2.1rem}.hero h1{max-width:20ch;margin:1.25rem 0 .85rem;color:var(--primary);font-size:52px;line-height:1.13;letter-spacing:-.04em}.intro{max-width:68ch;color:var(--on-surface-variant);font-size:17px;line-height:1.7}.certification{display:flex;align-items:center;gap:1rem;margin-top:1.5rem;padding:1.1rem 1.3rem;background:white;border:1px solid var(--border-passive);border-radius:1rem}.cert-icon{display:grid;place-items:center;flex:none;width:2.6rem;height:2.6rem;background:var(--pop-lime);border-radius:50%;font-weight:900}.certification strong{color:var(--primary)}.certification p{margin-top:.2rem;color:var(--on-surface-variant);font-size:13px;line-height:1.5}.cert-tag{margin-left:auto;padding:.4rem .65rem;background:#f5f3f0;border-radius:99px;color:var(--on-surface-variant);font-size:10px;font-weight:800;white-space:nowrap}.provisional{margin-top:.8rem;color:#68615a;font-size:11px}.layout{display:grid;grid-template-columns:minmax(245px,.72fr) minmax(0,1.7fr);gap:1.8rem;align-items:start}.aside{position:sticky;top:6rem;display:grid;gap:1rem}.toc{padding:1.25rem;background:white;border:1px solid var(--border-passive);border-radius:1rem}.toc-title{margin-bottom:.8rem;font-family:var(--font-display);font-size:19px;font-weight:800;color:var(--primary)}.toc-title span{margin-right:.45rem;color:#536b00}.toc ol{display:grid;gap:.15rem}.toc a{display:flex;gap:.55rem;padding:.62rem .4rem;border-radius:.5rem;color:var(--on-surface-variant);font-size:13px;font-weight:700;text-decoration:none}.toc a span{color:#536b00}.toc a:hover{background:var(--surface-low);color:var(--primary)}.quote{margin:0;padding:1.35rem;background:var(--primary);border-radius:1rem;color:white}.quote-kicker{color:var(--pop-lime);font-size:12px;font-weight:800;letter-spacing:.04em}.quote p{margin:.8rem 0 1rem;font-family:var(--font-display);font-size:17px;font-weight:600;line-height:1.55}.quote-sign{color:#d5e0d9;font-size:11px}.content{display:grid;gap:1.2rem}.card{padding:1.6rem;background:white;border:1px solid var(--border-passive);border-radius:1rem;scroll-margin-top:6rem}.card-heading{display:flex;align-items:center;gap:.9rem;margin-bottom:1rem}.number{display:grid;place-items:center;flex:none;width:2.5rem;height:2.5rem;background:var(--pop-lime);border-radius:50%;font-family:var(--font-display);font-weight:800}.eyebrow{margin:0 0 .25rem;color:#536b00;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.card h2{color:var(--primary);font-size:27px;line-height:1.2;letter-spacing:-.025em}.card>p:not(.eyebrow){margin-top:.7rem;color:var(--on-surface-variant);font-size:14px;line-height:1.7}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:1rem}.info-tile{display:grid;gap:.25rem;padding:.85rem;background:#f5f3f0;border-radius:.7rem}.info-tile span{color:var(--on-surface-variant);font-size:11px;font-weight:700}.info-tile strong{font-size:13px;line-height:1.5;overflow-wrap:anywhere}.callout{margin-top:1rem;padding:.9rem 1rem;background:#fff1e9;border-left:3px solid var(--persimmon);border-radius:.55rem;color:#4c1100;font-size:13px;line-height:1.6}.callout.green{background:#edf4e9;border-color:var(--primary-container);color:#173d2d}.hosting-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1rem}.hosting-tile{padding:1rem;background:#f5f3f0;border-radius:.8rem}.tile-icon{display:grid;place-items:center;width:2rem;height:2rem;background:var(--pop-lime);border-radius:50%;color:var(--primary);font-weight:900}.hosting-tile h3{margin:.65rem 0 .4rem;color:var(--primary);font-size:17px;line-height:1.3}.hosting-tile p{color:var(--on-surface-variant);font-size:12px;line-height:1.6}.mini-tag{display:inline-block;margin-top:.7rem;padding:.3rem .55rem;background:white;border-radius:99px;color:var(--on-surface-variant);font-size:10px;font-weight:800}.facts{display:grid;gap:.1rem;margin-top:1rem;overflow:hidden;border:1px solid var(--border-passive);border-radius:.7rem}.facts div{display:grid;grid-template-columns:.8fr 1.2fr;gap:.8rem;padding:.7rem .8rem;background:#fbf9f6;border-bottom:1px solid var(--border-passive);font-size:12px}.facts div:last-child{border-bottom:0}.facts dt{font-weight:800}.facts dd{margin:0;color:var(--on-surface-variant)}.card h3{margin:1.1rem 0 .4rem;color:var(--primary);font-family:var(--font-display);font-size:18px}.checklist{display:grid;gap:.1rem;margin-top:.75rem}.checklist li{display:flex;gap:.7rem;padding:.7rem 0;border-bottom:1px solid var(--border-passive)}.checklist li:last-child{border-bottom:0}.checklist li>span{display:grid;place-items:center;flex:none;width:1.5rem;height:1.5rem;background:#e7f1e6;border-radius:50%;color:var(--primary);font-weight:900}.checklist strong{font-size:13px}.checklist p{margin-top:.15rem;color:var(--on-surface-variant);font-size:12px;line-height:1.5}.rights{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1rem;padding:1rem;background:#f5f3f0;border-radius:.8rem}.rights strong{color:var(--primary);font-family:var(--font-display)}.rights p{max-width:54ch;margin-top:.35rem;color:var(--on-surface-variant);font-size:12px;line-height:1.55}.rights a{color:var(--primary);font-weight:700}.access-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin-top:1rem}.access-grid article{padding:.9rem;background:#f5f3f0;border-radius:.75rem}.access-grid article>span{color:#536b00;font-size:21px}.access-grid h3{margin:.45rem 0 .25rem;font-family:var(--font-body);font-size:13px;font-weight:800}.access-grid p{color:var(--on-surface-variant);font-size:11px;line-height:1.5}.cta-wrap{padding-block:3rem}.legal-cta{padding:2.5rem 1.5rem;background:var(--primary);border-radius:1.2rem;color:white;text-align:center}.legal-cta .eyebrow{color:var(--pop-lime)}.legal-cta h2{margin:.6rem 0;color:white;font-size:38px;line-height:1.2}.legal-cta>p:not(.eyebrow){max-width:58ch;margin:0 auto 1.2rem;color:#e4ebe5}.legal-cta :global(.btn){margin:auto}
@media(max-width:850px){.layout{grid-template-columns:1fr}.aside{position:static;grid-template-columns:1.25fr 1fr}.toc ol{grid-template-columns:1fr 1fr}.hosting-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.hero{padding-block:3rem 1.5rem}.hero h1{font-size:38px}.certification{align-items:flex-start;flex-wrap:wrap}.cert-tag{margin-left:3.6rem}.layout{gap:1rem}.aside{grid-template-columns:1fr}.toc ol{grid-template-columns:1fr}.card{padding:1.1rem}.card h2{font-size:23px}.info-grid,.hosting-grid,.access-grid{grid-template-columns:1fr}.facts div{grid-template-columns:1fr;gap:.25rem}.rights{align-items:flex-start;flex-direction:column}.legal-cta h2{font-size:29px}}
</style>
