---
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferCard from "../components/OfferCard.astro";
import Pill from '../components/Pill.astro';
import Button from '../components/Button.astro';
import ProjectCard from "../components/ProjectCard.astro";

const offers = [
  {
    tag: "Formule express",
    name: "Page Unique",
    price: "850 €",
    price_details: "TTC • Paiement en 2 ou 3 fois possible",
    note: "Idéal pour lancer une activité ou concentrer toute son offre sur une seule page. Paiement en 3 fois sans frais possible.",
    features: [
      "Design sur mesure, sobre et responsive",
      "Une page sculptée avec soin",
      "Formulaire de contact sans cookies",
      "Hébergement conseillé et configuré",
    ],
    cta: "Choisir la Page Unique",
    href: "/contact",
  },
  {
    tag: "Formule complète",
    name: "Site Vitrine",
    price: "1 450 €",
    price_details: "TTC • Livrable complet clé en main",
    note: "L'arme absolue des artisans, freelances et créateurs engagés.",
    features: [
      "3 à 5 pages sur mesure",
      "Référencement de base soigné",
      "Formation vidéo de 30 minutes",
      "Autonomie après livraison",
    ],
    cta: "Choisir le Site Vitrine",
    href: "/contact",
    featured: true,
  },
  {
    tag: "Formule commerce",
    name: "Boutique en Ligne",
    price: "2 200 €",
    price_details: "TTC • Architecture micro-boutique fluide",
    note: "Vendez vos créations sans faire exploser la facture énergétique.",
    features: [
      "Catalogue produits et tunnel de commande",
      "Paiement en ligne sécurisé",
      "Emails transactionnels sobres",
      "Formation vidéo de 30 minutes",
    ],
    cta: "Choisir la Boutique",
    href: "/contact",
  },
];

const projects = [
  {
    category: "E-commerce • Bijoux artisanaux",
    categoryTone: "lime" as const,
    image: "/images/sites/saboom.png",
    imageAlt: "Aperçu du site Saboom, boutique de bijoux artisanaux",
    title: "Saboom Bijoux",
    subtitle: "Boutique en ligne",
    description:
      "Une identité pétillante pour des bijoux en pâte polymère, avec un site pensé pour rester léger sans rien perdre de sa couleur.",
    href: "/projets",
    metrics: [
      { label: "Poids page", value: "142 Ko" },
      { label: "Éco-index", value: "89/100 (A)" },
      { label: "Vitesse mobile", value: "0,6 s" },
    ],
    draft: false,
  },
  {
    category: "Catégorie à définir",
    categoryTone: "sky" as const,
    image: "/images/sites/projet-a-venir-1.png",
    imageAlt: "Visuel du projet à venir",
    title: "Projet à venir",
    subtitle: "Type de projet à définir",
    description: "Description à ajouter quand le projet sera prêt à présenter.",
    href: "/projets",
    metrics: [],
    draft: false,
  },
  {
    category: "Catégorie à définir",
    categoryTone: "lime" as const,
    image: "/images/sites/projet-a-venir-2.png",
    imageAlt: "Visuel du projet à venir",
    title: "Projet à venir",
    subtitle: "Type de projet à définir",
    description: "Description à ajouter quand le projet sera prêt à présenter.",
    href: "/projets",
    metrics: [],
    draft: false,
  },
];
---

<BaseLayout
  title="Accueil"
  description="Popup Studio crée des sites web éco-conçus et créatifs pour les indépendant.e.s, TPE, associations et créateur.ices. Moins de code, plus d’audace."
>
  <!-- 1. HERO -->
  <section class="hero container">
    <!-- FICTIF -->
    <Pill tone="lime"><span aria-hidden="true">🌱</span> Moins de CO2, plus de clients</Pill>
    <h1>
      Création de sites web engagés pour indépendant.e.s & créateur.ices
    </h1>
    <p class="hero__lead">
      (En gros : tout ce que tu veux, mais un site web pas égoïste ni glouton en énergie.)
    </p>
    <div class="hero__actions">
      <Button variant="primary" href="/contact" size="lg">Demander un devis gratuit <span aria-hidden="true">🚀</span></Button>
      <Button variant="ghost" href="/offres-tarifs" size="lg">Découvrir les offres</Button>
    </div>
    <ul class="hero__chips">
      <li class="chip"><span aria-hidden="true">⚡</span> Chargement rapide</li>
      <li class="chip"><span aria-hidden="true">🌿</span> Hébergement en France</li>
      <li class="chip"><span aria-hidden="true">🔒</span> Zéro cookie</li>
    </ul>
  </section>

  <!-- 2. STORYTELLING -->
<section class="band">
  <div class="container storytelling">
    <figure class="storytelling__visual">
      <!-- Visuel généré avec GPT -->
      <img
        src="/images/brigitte.png"
        alt="Illustration : Brigitte, cliente pressée, souriante dans une cuisine"
        width="600"
        height="500"
        loading="lazy"
      />
      <span class="storytelling__badge"><Pill tone="lime">Le cas Tante Brigitte</Pill></span>
      <figcaption class="storytelling__caption">
        <span class="storytelling__caption-label">Brigitte, cliente pressée</span>
        Trente secondes de patience, un téléphone, et une fuite sous l'évier.
      </figcaption>
    </figure>

    <div class="storytelling__text">
      <p class="eyebrow storytelling__eyebrow">Pourquoi avoir un site web ?</p>
      <h2>Tante Brigitte t'a cherché. Elle a trouvé quelqu'un d'autre.</h2>
      <p>
        Tante Brigitte a besoin d'une céramiste pour un cadeau, d'un plombier pour sa fuite ou d'une photographe pour le mariage de sa nièce. Elle sort son téléphone, tape trois mots, regarde les deux premiers résultats. Elle ne lit pas les avis en détail, elle ne scrolle pas jusqu'en bas. Elle veut savoir ce que tu fais, où tu es et comment t'appeler. Point.
      </p>
      <p>
        Si ta page n'existe pas, elle ne t'en voudra pas : elle ne saura jamais que tu existes. Si ta page met trop longtemps à s'afficher sur son forfait à deux barres de réseau, elle repart aussi. Un site léger, clair et honnête, c'est juste ce qui permet à tante Brigitte de te trouver, de te comprendre et de t'appeler. Rien de plus, rien de moins.
      </p>
      <div class="storytelling__moral">
        <span class="storytelling__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V16h8v-1.3A7 7 0 0 0 12 2z"/>
          </svg>
        </span>
        <div>
          <p class="storytelling__moral-title">Ton site répond à ta place quand tu as les mains dans le travail.</p>
          <p>
            Pas de pages à rallonge, pas de jargon, pas d'animation qui fait ramer le téléphone. Juste l'essentiel, bien dit, qui charge vite. Et une fois livré, tu sais le faire vivre toi-même.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>


  <!-- 3. ÉCOLOGIE & REPÈRES -->
  <!-- Ces métriques sont fictives/provisoires ; elles ne constituent pas des preuves vérifiées. -->
  <section class="stats" aria-labelledby="stats-title">
    <div class="container">
      <p class="eyebrow eyebrow--light stats__eyebrow">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4.5a3.2 3.2 0 0 0-5.8 1.9 3.5 3.5 0 0 0-1 6.6A3.2 3.2 0 0 0 8 18.5h4V4.5Zm0 0a3.2 3.2 0 0 1 5.8 1.9 3.5 3.5 0 0 1 1 6.6 3.2 3.2 0 0 1-2.8 5.5H12V4.5Z"/><path d="M8 9.5h.01M16 9.5h.01M8.5 14h.01m7-.01h.01M12 4.5v13.9"/></svg>
        Vulgarisation scientifique &amp; bienveillante
      </p>
      <h2 id="stats-title">Hop hop hop&#8239;! Oui mais Jamy… Pourquoi ton site peut (et doit) faire mieux pour la planète&#8239;?</h2>
      <p class="stats__lead">
        Internet consomme de l’électricité, et chaque page a sa part. La bonne nouvelle&#8239;? En allégeant images, scripts et contenus superflus, tu peux réduire l’impact de ton site — sans lui enlever son style.
      </p>
      <div class="stats__grid">
        <article class="stat stat--warning">
          <span class="stat__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.3 3.9-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3.1l-8-14a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4m0 4h.01"/></svg>
          </span>
          <p class="stat__value"><span>4,6</span><small>g</small></p>
          <h3 class="stat__label">de CO₂ / page vue</h3>
          <p class="stat__text">Repère provisoire pour une page dite <strong>conventionnelle</strong>. Le résultat varie selon le <strong>poids de la page</strong>, l’appareil et la méthode de calcul.</p>
          <span class="stat__chip stat__chip--warning">Web conventionnel</span>
        </article>
        <article class="stat stat--method">
          <span class="stat__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 3.2c-7.4-.3-13.2 1.5-15.6 5.6-1.9 3.3-.6 7.3 2.4 8.5 3 1.1 6.2-.6 8.3-3.6 2.3-3.2 3.3-7 4.9-10.5Z"/><path d="M3 21c2.8-5.2 6.8-8.8 12-11"/></svg>
          </span>
          <p class="stat__value"><span>−65</span><small>&#8239;%</small></p>
          <h3 class="stat__label">d’empreinte nette</h3>
          <p class="stat__text">Un chiffre indicatif, pas une promesse. Images mieux dimensionnées, scripts limités et <strong>code léger</strong>&#8239;: des pistes concrètes pour alléger un site.</p>
          <span class="stat__chip stat__chip--method">Méthode Popup Studio</span>
        </article>
        <article class="stat stat--indicative">
          <span class="stat__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16.5 9"/></svg>
          </span>
          <p class="stat__value"><span>71</span><small>&#8239;%</small></p>
          <h3 class="stat__label">plus propre que le web</h3>
          <p class="stat__text">Valeur indicative, sans comparaison vérifiée. Il faudra préciser le périmètre et la méthode avant d’en tirer une conclusion.</p>
          <span class="stat__chip stat__chip--indicative">À vérifier</span>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. OFFRES -->
<section class="offers-section container" aria-labelledby="offers-title">
  <p class="eyebrow offers-section__eyebrow">Solutions & accompagnement</p>
  <h2 id="offers-title">Ce que je peux faire pour toi</h2>
  <p class="offers-section__lead">
    Trois formules claires, garanties sans jargon technique indigeste ni frais cachés.
  </p>

  <div class="offers">
    {offers.map((o) => <OfferCard {...o} />)}
  </div>

  <p class="section__more">
    <a href="/offres-tarifs" class="link-arrow">
      Comparer toutes les formules en détail <span aria-hidden="true">→</span>
    </a>
  </p>
</section>

<!-- 5. PROJETS -->
<section class="section container" aria-labelledby="projects-title">
  <div class="section__head">
    <div>
      <p class="eyebrow">Travaux récents</p>
      <h2 id="projects-title">Un projet qui claque, sans en faire trop</h2>
    </div>

    <Button href="/projets" variant="ghost">
      Voir le projet <span aria-hidden="true">→</span>
    </Button>
  </div>

  <div class="projects-grid">
    {projects
  .filter((project) => !project.draft)
  .map((project) => <ProjectCard {...project} />)}
  </div>
</section>

  <!-- 6. TÉMOIGNAGE -->
  <section class="section container">
    <!-- FICTIF : témoignage provisoire -->
    <figure class="quote">
      <blockquote>
        « Un site ultra rapide, canon, et qui correspond exactement à mes valeurs
        écolos. Et Axel m’a écouté et fait rire en même temps. »
      </blockquote>
      <figcaption>Léa M., créatrice indépendante</figcaption>
    </figure>
  </section>

  <!-- 7. CTA FINAL -->
  <section class="container">
    <div class="cta">
      <p class="eyebrow eyebrow--light">Passe à l’action</p>
      <h2>Prêt.e à créer un site qui te ressemble (sans carboniser la planète) ?</h2>
      <p>
        On s’appelle 20 minutes pour faire le tour de tes besoins, estimer ton
        budget et voir ensemble ce qui est possible.
      </p>
      <div class="hero__actions">
        <Button href="/contact" variant="pop" size="lg">Discuter de mon projet <span aria-hidden="true">💬</span></Button>
        <a href="mailto:axel@popupstudio.fr" class="cta__mail">ou écris-moi : axel@popupstudio.fr</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Atomes --- */
  h2 {
    font-size: 40px;
    line-height: 48px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: var(--space-xs) 0.75rem;
    background: var(--white);
    border: 1.5px solid var(--border-passive);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
  }
  .link-arrow { font-weight: 700; text-underline-offset: 4px; }

  /* --- Sections --- */
  .section { padding-block: var(--space-xl); }
  .section__lead { margin-top: var(--space-sm); color: var(--on-surface-variant); }
  .section__more { margin-top: var(--space-lg); text-align: center; }
  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gutter);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  /* --- Hero --- */
  .hero {
    padding-block: 5rem var(--space-xl);
    text-align: center;
  }
  .hero h1 {
    max-width: 22ch;
    margin: var(--space-md) auto;
    font-size: 56px;
    line-height: 64px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .hero__lead {
    max-width: 60ch;
    margin: 0 auto var(--space-lg);
    font-size: 18px;
    line-height: 28px;
    color: var(--on-surface-variant);
  }
  .hero__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__chips {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* --- Norbert --- */
.band { background: var(--surface-low); padding-block: var(--space-xl); }
.storytelling {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: var(--space-xl);
  align-items: center;
}

/* Visuel */
.storytelling__visual {
  position: relative;
  margin: 0;
}
.storytelling__visual img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 6 / 5;
  object-fit: cover;
  border-radius: var(--radius-lg);
  border: 1.5px solid var(--border-passive);
  background: var(--surface-container);
}
.storytelling__badge {
  position: absolute;
  top: -0.75rem;
  right: -0.75rem;
}
.storytelling__caption {
  position: absolute;
  left: var(--space-sm);
  right: var(--space-sm);
  bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background: var(--white);
  border: 1.5px solid var(--border-passive);
  border-radius: var(--radius-md, 0.75rem);
  font-weight: 700;
  font-size: 15px;
  line-height: 20px;
  color: var(--ink);
}
.storytelling__caption-label {
  display: block;
  font-size: 11px;
  line-height: 16px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--secondary, #4f6600);
}

/* Texte */
.storytelling__text { display: flex; flex-direction: column; gap: var(--space-md); }
.storytelling__eyebrow { margin-bottom: 0; color: var(--secondary, #4f6600); }
.storytelling__text h2 { color: var(--primary-container); }
.storytelling__text > p:not(.eyebrow) {
  font-size: 16px;
  line-height: 24px;
  color: var(--on-surface-variant);
}

/* Morale */
.storytelling__moral {
  display: flex;
  gap: var(--space-md);
  align-items: flex-start;
  margin-top: var(--space-sm);
  padding: var(--space-lg);
  background: var(--primary);
  color: var(--white);
  border-radius: var(--radius-lg);
}
.storytelling__icon {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  background: var(--pop-lime);
  color: var(--ink);
  border-radius: var(--radius-full);
}
.storytelling__moral-title {
  margin-bottom: var(--space-xs);
  font-weight: 700;
  color: var(--pop-lime);
}
.storytelling__moral p:not(.storytelling__moral-title) {
  font-size: 14px;
  line-height: 20px;
}
/* ---------- Écologie / statistiques ---------- */
.stats {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-block: var(--space-xl);
  background-color: var(--primary-container);
  background-image: radial-gradient(circle, color-mix(in srgb, var(--on-primary-container) 16%, transparent) 1px, transparent 1.4px);
  background-size: 24px 24px;
  color: var(--white);
}
.stats > .container { position: relative; }
.stats .eyebrow--dark { background: var(--ink-base); }
.stats__eyebrow { margin-bottom: var(--space-md); }
.stats h2 { max-width: 28ch; }
.stats__lead {
  max-width: 64ch;
  margin: var(--space-md) 0 var(--space-lg);
  color: var(--on-primary-container);
}
.stats__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--gutter);
  align-items: stretch;
}
.stat {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--space-lg);
  background: var(--primary);
  border: 1.5px solid color-mix(in srgb, var(--white) 16%, transparent);
  border-radius: var(--radius-lg);
}
.stat__icon {
  display: grid;
  width: 3rem;
  height: 3rem;
  margin-bottom: var(--space-md);
  place-items: center;
  border-radius: var(--radius-full);
}
.stat__icon svg { width: 1.4rem; height: 1.4rem; }
.stat--warning .stat__icon {
  background: var(--tertiary-container);
  color: var(--on-tertiary-container);
}
.stat--method .stat__icon { background: var(--pop-lime); color: var(--on-secondary-fixed, var(--ink)); }
.stat--indicative .stat__icon { background: var(--sky-tint); color: var(--ink); }
.stat__value {
  display: flex;
  align-items: baseline;
  gap: var(--space-xs);
  margin: 0;
  color: var(--white);
  font-family: var(--font-display);
  font-size: 40px;
  font-weight: 800;
  line-height: 48px;
  letter-spacing: -0.02em;
}
.stat--method .stat__value { color: var(--pop-lime); }
.stat__value small {
  color: var(--on-primary-container);
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
}
.stat__label { margin: var(--space-xs) 0 var(--space-sm); color: var(--white); font-size: 18px; line-height: 26px; }
.stat__text { color: var(--on-primary-container); font-size: 14px; line-height: 20px; margin-bottom: var(--space-lg); }
.stat__text strong { color: var(--white); font-weight: 700; }
.stat__chip {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: auto;
  padding: var(--space-xs) 0.75rem;
  border-radius: var(--radius-full);
  font-size: 11px;
  font-weight: 700;
  line-height: 16px;
}
.stat__chip--warning {
  background: color-mix(in srgb, var(--tertiary-container) 72%, transparent);
  color: var(--on-tertiary-container);
}
.stat__chip--method { background: var(--pop-lime); color: var(--ink); }
.stat__chip--indicative { background: var(--sky-tint); color: var(--ink); }

  /* --- Offres --- */
  .offers-section {
  padding-block: var(--space-xl);
  text-align: center;
}

.offers-section__eyebrow {
  margin-bottom: var(--space-xs);
  font-size: 0.6rem;
}

.offers-section h2 {
  color: var(--primary-container);
}

.offers-section__lead {
  margin-top: var(--space-xs);
  color: var(--on-surface-variant);
  font-size: 14px;
  line-height: 20px;
}

.offers {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--gutter);
  margin-top: var(--space-xl);
  text-align: left;
}

.offers-section .section__more {
  margin-top: var(--space-lg);
  font-size: 14px;
}

.offers-section .link-arrow {
  color: var(--primary-container);
  text-underline-offset: 4px;
}

@media (max-width: 64rem) {
  .offers {
    grid-template-columns: 1fr;
    max-width: 34rem;
    margin-inline: auto;
  }
}

@media (max-width: 48rem) {
  .offers-section {
    padding-block: var(--space-xl);
  }
}

  /* --- Témoignage --- */
  .quote {
    margin: 0;
    padding: var(--space-xl);
    background: var(--surface-low);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .quote blockquote {
    max-width: 48ch;
    margin: 0 auto var(--space-md);
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 36px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .quote figcaption { font-size: 14px; font-weight: 600; color: var(--on-surface-variant); }

  /* --- CTA final --- */
  .cta {
    margin-bottom: var(--space-xl);
    padding: 5rem var(--space-xl);
    background:
    radial-gradient(
      ellipse 45% 75% at 100% 100%,
      rgba(108, 157, 74, 0.35) 0%,
      rgba(108, 157, 74, 0) 100%
    ),
