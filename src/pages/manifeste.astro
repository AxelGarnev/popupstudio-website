---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pill from "../components/Pill.astro";
import Button from "../components/Button.astro";

const title = "Manifeste — fabriquer un web plus sobre | Popup Studio";
const description = "Les choix de Popup Studio pour un web plus sobre, accessible et singulier : manifeste, méthode transparente et simulateur pédagogique.";

// Chiffres de démonstration provisoires : les conserver visibles pour fidélité à la maquette, sans les présenter comme des résultats audités.
const stats = [
  { value: "0,08 g", label: "CO₂ par page vue", note: "Valeur provisoire de maquette, à mesurer et sourcer." },
  { value: "100%", label: "Hébergé en France", note: "Indication de design à vérifier projet par projet." },
  { value: "AAA", label: "Accessibilité", note: "Objectif fictif, aucun audit ou niveau de conformité établi." },
  { value: "0", label: "Mouchard ajouté", note: "Repère de maquette, à confirmer selon les outils actifs." },
];
const commandments = [
  { n:"01", title:"La règle du gramme près", text:"Des images dimensionnées au besoin, des formats adaptés et du SVG quand il fait le travail. Une vidéo en boucle peut attendre qu’on lui demande la parole.", tag:"Poids maîtrisé, sans promesse chiffrée" },
  { n:"02", title:"Zéro graisse JavaScript superflue", text:"Le HTML sait déjà faire beaucoup. On ajoute du script quand il rend un vrai service, pas pour animer chaque virgule.", tag:"Du code utile, documenté" },
  { n:"03", title:"Hébergement choisi avec les faits", text:"On regarde la localisation, les besoins du projet et les données disponibles. « Vert » n’est pas une preuve : si une info manque, on le dit.", tag:"Hébergeur à vérifier au cas par cas" },
  { n:"04", title:"Pas de mouchards, pas d’otages", text:"Pas de traceur publicitaire ajouté par défaut. Si une mesure est utile, on vérifie ce qu’elle collecte et on choisit une option adaptée.", tag:"Outils tiers à examiner" },
  { n:"05", title:"Accessibilité & durabilité", text:"Contrastes, structure des titres, clavier et contenus compréhensibles : l’accessibilité se teste avec des personnes et des outils, elle ne s’improvise pas.", tag:"Tests à mener, niveau non certifié" },
  { n:"06", title:"Autonomie & liberté totale", text:"Tu gardes la main sur ton site et tes contenus. On explique les choix et on évite les dépendances qui te retiennent en otage.", tag:"La prise en main fait partie du projet" },
];
---

<BaseLayout title={title} description={description}>
  <section class="container hero manifesto-hero" aria-labelledby="manifesto-title">
    <div class="hero-copy">
      <Pill tone="lime">Zéro poudre aux yeux · un bilan transparent</Pill>
      <h1 id="manifesto-title">Notre Manifeste : fabriquer un web qui ne fait pas <span>fondre la banquise</span>.</h1>
      <p class="hero-lead">Un site n’a pas besoin d’empiler les scripts, les fenêtres intrusives et les vidéos en boucle pour être beau, mémorable et utile. On choisit les bons outils, on explique nos arbitrages et on garde le superflu dehors.</p>
      <div class="quick-pills"><Pill tone="sky">Poids médian livré : &lt; 220 Ko*</Pill><Pill tone="neutral">Des choix vérifiables, projet par projet</Pill></div>
    </div>
    <div class="stats-grid" aria-label="Repères provisoires de la maquette">
      {stats.map((s) => <article class="stat-card"><span class="accent" aria-hidden="true"></span><p class="stat-value">{s.value}</p><h2>{s.label}</h2><p class="stat-note">{s.note}</p></article>)}
    </div>
    <p class="provisional"><strong>Chiffres provisoires, à ajuster.</strong> Les valeurs, scores, pourcentages, poids et allégations de cette maquette sont fictifs ou non vérifiés ; ils ne constituent ni audit ni certification.</p>
    <!-- Tous les chiffres, scores et affirmations de performance/environnement affichés dans cette page sont provisoires et doivent être vérifiés avant publication comme résultats. -->
  </section>

  <section class="band commandments" aria-labelledby="commandments-title">
    <div class="container section">
      <div class="section-head"><div><p class="eyebrow">Code de déontologie technique</p><h2 id="commandments-title">Les 6 Commandements de Popup Studio</h2></div><p class="section-lead">Pas de vœux pieux : des choix concrets, adaptés à ton projet et expliqués sans jargon inutile.</p></div>
      <div class="commandment-grid">{commandments.map((c) => <article class="commandment-card"><div class="card-top"><span class="number">{c.n}</span><span class="command-icon" aria-hidden="true">{c.n === "01" ? "↘" : c.n === "02" ? "</>" : c.n === "03" ? "⌂" : c.n === "04" ? "◉" : c.n === "05" ? "＋" : "↗"}</span></div><h3>{c.title}</h3><p>{c.text}</p><div class="card-foot"><span aria-hidden="true">✓</span>{c.tag}</div></article>)}</div>
    </div>
  </section>

  <section class="container section method" id="methode" aria-labelledby="method-title">
    <div class="method-grid">
      <div class="method-copy"><Pill tone="sky">Méthodologie ouverte</Pill><h2 id="method-title">Comment calcule-t-on ce bilan ? La méthode sans filtre</h2>
        <p>Une estimation dépend de ce qu’on compte : les données transférées, le terminal qui affiche la page, le réseau et les hypothèses énergétiques. Pour un vrai bilan, il faut documenter les données, la méthode, le périmètre et la date.</p>
        <p>Cette page ne prétend pas appliquer un calcul vérifié. Les repères chiffrés ci-contre sont une illustration provisoire, pas une mesure de Popup Studio.</p>
        <aside class="jamy"><p class="jamy-title">La minute de Jamy</p><p>« Le cloud n’a rien de vaporeux. Une page voyage entre des machines, des réseaux et ton appareil. Tout ça consomme de l’énergie ; moins il y a de données à transférer, moins on expédie de superflu. C’est tout bête — et ça mérite quand même qu’on vérifie les calculs ! »</p><small>Jamy est ici un clin d’œil pédagogique, pas un intervenant ou une caution.</small></aside>
      </div>
      <div class="visual-column">
        <div class="comparison"><div class="comparison-head"><div><p class="eyebrow">Simulation annuelle d’émissions</p><p>Exemple illustratif · 50 000 visites/an</p></div><span class="mini-badge">À vérifier</span></div>
          <article class="sim-row standard"><div class="row-title"><h3>Un site conventionnel</h3><strong>230,5 kg CO₂/an</strong></div><p>4,61 g CO₂/page · 3,8 Mo · 87 requêtes tierces</p><div class="meter"><span style="width:100%"></span></div><small>Ordre de grandeur fictif, non attribuable à un site réel.</small></article>
          <article class="sim-row lighter"><div class="row-title"><h3>Un site plus léger</h3><strong>4,5 kg CO₂/an</strong></div><p>0,09 g CO₂/page · 180 Ko · 6 requêtes locales</p><div class="meter"><span style="width:8%"></span></div><small>Comparaison de maquette ; hypothèses non validées.</small></article>
          <div class="chart-title">Évolution comparative de l’empreinte cumulée</div>
          <svg class="chart" viewBox="0 0 400 100" role="img" aria-label="Graphique schématique : deux courbes illustratives, données provisoires"><path class="gridline" d="M0 25H400M0 50H400M0 75H400"/><path d="M5 88 Q100 78 190 56 T395 14" fill="none" stroke="#711e00" stroke-width="3" stroke-dasharray="6 6"/><path d="M5 90 Q100 88 190 86 T395 82" fill="none" stroke="#4f6600" stroke-width="4"/><circle cx="395" cy="14" r="4" fill="#711e00"/><circle cx="395" cy="82" r="4" fill="#4f6600"/></svg>
          <div class="chart-labels"><span>Mois 01</span><span>Mois 06</span><span>Mois 12</span></div>
          <p class="micro-note">Courbes et chiffres de démonstration — aucune évolution mesurée.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container simulator-wrap" id="simulateur" aria-labelledby="sim-title">
    <div class="simulator"><div class="sim-intro"><Pill tone="lime">À toi de jouer · estimation seulement</Pill><h2 id="sim-title">Teste l’empreinte carbone de ton propre projet</h2><p>Ajuste les paramètres et observe un ordre de grandeur pédagogique. Ce calcul simplifié n’est ni un bilan carbone ni un audit.</p></div>
      <div class="sim-layout"><form class="sim-form" id="footprint-form">
        <fieldset><legend><span>1</span> Trafic mensuel estimé</legend><label class="range-label" for="visits-range"><output id="visits-output" for="visits-range">5 000</output> pages vues / mois</label><input class="traffic-range" id="visits-range" name="traffic" type="range" min="1000" max="100000" step="500" value="5000" /><div class="range-presets"><button type="button" data-visits="1000">1 000 · démarrage</button><button type="button" data-visits="5000">5 000 · TPE</button><button type="button" data-visits="20000">20 000 · commerce</button><button type="button" data-visits="50000">50 000+</button></div></fieldset>
        <fieldset><legend><span>2</span> Poids estimé d’une page</legend><div class="choice-stack"><label><input type="radio" name="weight" value="3.5" /><span><b>Lourd · 3,5 Mo</b><small>Exemple de site chargé</small></span></label><label><input type="radio" name="weight" value="1.8" checked /><span><b>Moyen · 1,8 Mo</b><small>Exemple intermédiaire</small></span></label><label><input type="radio" name="weight" value="2.4" /><span><b>Je ne sais pas · 2,4 Mo</b><small>Valeur par défaut de la maquette</small></span></label></div></fieldset>
        <fieldset><legend><span>3</span> Hébergement actuel</legend><div class="choice-stack"><label><input type="radio" name="hosting" value="440" checked /><span><b>Standard · hypothèse monde</b><small>Facteur fictif : 440 g CO₂/kWh</small></span></label><label><input type="radio" name="hosting" value="80" /><span><b>France · hypothèse bas-carbone</b><small>Facteur fictif : 80 g CO₂/kWh, à documenter</small></span></label></div></fieldset>
      </form>
      <aside class="result-card" aria-live="polite"><div class="result-head"><span>Estimation illustrative</span><Pill tone="lime">Modèle simplifié</Pill></div><div class="result-numbers"><div><small>Paramètres actuels</small><strong id="current-result">—</strong><span>kg CO₂ / an*</span></div><div class="popup-result"><small>Avec page à 180 Ko*</small><strong id="lighter-result">—</strong><span>kg CO₂ / an*</span></div></div><div class="result-delta"><span>Écart calculé dans cette simulation</span><strong id="difference-result">—</strong></div><p class="result-note">* Estimation purement pédagogique : formule simplifiée basée sur le trafic, le poids de page et le facteur d’hébergement sélectionnés. Le résultat ne prédit pas l’impact réel et ne doit pas être utilisé comme déclaration environnementale.</p><p class="reality">Traduction dans la vraie vie : une piste de réflexion, pas un compteur certifié.</p></aside></div>
    </div>
  </section>

  <section class="band proof-band" aria-labelledby="proof-title"><div class="container section proof-section"><div class="proof-copy"><Pill tone="sky">Nos repères de conception</Pill><h2 id="proof-title">La preuve par les faits</h2><p>Un chiffre seul ne prouve rien. Voici les indicateurs de la maquette, affichés pour leur rôle visuel et à remplacer par des mesures sourcées avant toute publication comme résultats.</p><p class="provisional compact"><strong>Chiffres provisoires, à ajuster.</strong> Aucun score, poids ou résultat ci-dessous n’est vérifié.</p><div class="proof-stats"><article><strong>94<span>/100</span></strong><small>Score d’exemple</small></article><article><strong>99<span>/100</span></strong><small>Score d’exemple</small></article><article><strong>184 Ko</strong><small>Poids d’exemple</small></article></div></div><div class="terminal" aria-label="Exemple fictif de sortie de terminal"><div class="terminal-bar"><i></i><i></i><i></i><span>rapport-de-demo.txt</span></div><pre><code><span>$</span> audit-popup --page accueil

[info] Mesure illustrative
[info] Transfert : 184 Ko
[info] Score : 94 / 100
[info] État : chiffres provisoires

<span>›</span> Pas de certification générée.</code></pre></div></div></section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#footprint-form");
  const current = document.querySelector<HTMLElement>("#current-result");
  const lighter = document.querySelector<HTMLElement>("#lighter-result");
  const difference = document.querySelector<HTMLElement>("#difference-result");
  const format = (value: number) => value.toLocaleString("fr-FR", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  function updateEstimate() {
    if (!form || !current || !lighter || !difference) return;
    const visits = Number(form.querySelector<HTMLInputElement>('input[name="traffic"]')?.value || 5000) * 12;
    const visitsOutput = document.querySelector<HTMLOutputElement>("#visits-output");
    if (visitsOutput) visitsOutput.value = Number(visits / 12).toLocaleString("fr-FR");
    const weightMb = Number(form.querySelector<HTMLInputElement>('input[name="weight"]:checked')?.value || 1.8);
    const hostingFactor = Number(form.querySelector<HTMLInputElement>('input[name="hosting"]:checked')?.value || 440);
    // Estimateur illustratif arbitraire, non validé comme méthodologie carbone.
    const factor = hostingFactor / 440;
    const oldEstimate = visits * weightMb * 0.00003 * factor;
    const newEstimate = visits * 0.18 * 0.00003 * factor;
    current.textContent = format(oldEstimate);
    lighter.textContent = format(newEstimate);
    difference.textContent = `${format(Math.max(0, oldEstimate - newEstimate))} kg CO₂/an*`;
  }
  form?.addEventListener("input", updateEstimate);
  form?.addEventListener("change", updateEstimate);
  document.querySelectorAll<HTMLButtonElement>("[data-visits]").forEach((button) => {
    button.addEventListener("click", () => {
      const slider = form?.querySelector<HTMLInputElement>('input[name="traffic"]');
      if (slider) slider.value = button.dataset.visits || "5000";
      updateEstimate();
    });
  });
  updateEstimate();
</script>

<style>
  :global(:root){--m-ink:#141514;--m-green:#012d1d;--m-lime:#cdec7b;--m-accent:#f45010;--m-violet:#3a1b79;--m-sky:#acd6f6;--m-paper:#fbf9f6;--m-muted:#414844;--m-border:rgba(20,21,20,.14)}
  .manifesto-hero{padding-block:3rem 4rem}.hero-copy{max-width:950px}.hero-copy h1{max-width:18ch;margin:1.25rem 0;color:var(--m-green);font-size:clamp(2.6rem,6vw,4.6rem);line-height:1.08;letter-spacing:-.045em;font-weight:800}.hero-copy h1 span{text-decoration:underline wavy var(--m-lime);text-decoration-thickness:6px;text-underline-offset:8px}.hero-lead{max-width:70ch;color:var(--m-muted);font-size:18px;line-height:1.7}.quick-pills{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.5rem}.stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.25rem;margin-top:3.5rem}.stat-card{display:flex;min-height:240px;flex-direction:column;background:#fff;border:1px solid var(--m-border);border-radius:1rem;padding:1.5rem}.accent{display:block;width:3rem;height:6px;margin-bottom:1.4rem;border-radius:9px;background:var(--m-lime)}.stat-card:nth-child(2) .accent{background:var(--m-sky)}.stat-card:nth-child(3) .accent{background:#ffdbd0}.stat-card:nth-child(4) .accent{background:#b5d264}.stat-value{margin:.1rem 0;color:var(--m-green);font-size:clamp(2rem,3.3vw,2.75rem);font-weight:800;letter-spacing:-.04em}.stat-card h2{margin:.2rem 0 .5rem;color:var(--m-green);font-size:17px;line-height:1.35}.stat-note{margin-top:auto;color:var(--m-muted);font-size:13px;line-height:1.55}.provisional{margin:1.5rem 0 0;padding:1rem 1.2rem;background:#fff0e8;border-left:4px solid var(--m-accent);border-radius:.35rem;color:#4c1100;font-size:14px;line-height:1.6}.band{background:#f5f3f0}.section{padding-block:5rem}.section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2.5rem}.eyebrow{margin:0 0 .65rem;color:#536b00;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.section-head h2,.method h2,.proof-copy h2{max-width:22ch;margin:0;color:var(--m-green);font-size:clamp(2rem,4vw,2.65rem);line-height:1.14;letter-spacing:-.035em}.section-lead{max-width:42ch;margin:0;color:var(--m-muted);line-height:1.65}.commandment-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem}.commandment-card{display:flex;min-height:330px;flex-direction:column;padding:1.8rem 1.75rem 1.25rem;background:white;border:1px solid var(--m-border);border-radius:1rem;transition:transform .18s,border-color .18s}.commandment-card:hover{transform:translateY(-3px);border-color:#758b5a}.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.6rem}.number{color:#4f6600;font-size:2rem;font-weight:800;letter-spacing:-.04em}.command-icon{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:var(--m-lime);color:var(--m-green);font-size:17px;font-weight:800}.commandment-card h3{margin:0 0 .7rem;color:var(--m-green);font-size:20px;line-height:1.3}.commandment-card>p{margin:0;color:var(--m-muted);font-size:14px;line-height:1.7}.card-foot{display:flex;align-items:center;gap:.55rem;margin:auto -1.75rem -1.25rem;padding:.9rem 1.75rem;background:#f5f3f0;border-radius:0 0 1rem 1rem;color:var(--m-ink);font-size:12px;font-weight:700}.card-foot span{color:#536b00;font-weight:900}.method{padding-block:5rem}.method-grid{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.15fr);gap:3rem;align-items:start}.method-copy h2{margin:1rem 0}.method-copy>p{color:var(--m-muted);line-height:1.75}.jamy{margin-top:1.5rem;padding:1.5rem;background:#efeeeb;border-radius:1rem;border-left:4px solid var(--m-lime)}.jamy-title{margin:0 0 .65rem;color:var(--m-green);font-size:17px;font-weight:800}.jamy p:nth-child(2){margin:0;color:var(--m-muted);font-size:14px;line-height:1.7;font-style:italic}.jamy small{display:block;margin-top:.9rem;color:#536b00;font-size:11px;font-weight:700}.comparison{padding:1.75rem;background:#fff;border:1px solid var(--m-border);border-radius:1.25rem}.comparison-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.4rem}.comparison-head .eyebrow{margin-bottom:.2rem}.comparison-head p:last-child