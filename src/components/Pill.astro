---
interface Props {
  tone?: 'lime' | 'sky' | 'neutral';
}
const { tone = 'neutral' } = Astro.props;
---

<span class:list={['pill', `pill--${tone}`]}><slot /></span>

<style>
  .pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #141514;
  }
  .pill--lime { background: #c8e676; }
  .pill--sky { background: #acd6f6; }
  .pill--neutral { background: #faf8f5; border: 1.5px solid rgba(20, 21, 20, 0.12); }
</style>