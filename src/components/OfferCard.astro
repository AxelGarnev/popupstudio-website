---
interface Props {
  tag: string;
  name: string;
  price: string;
  note: string;
  features: string[];
  cta: string;
  href: string;
  featured?: boolean;
}
const { tag, name, price, note, features, cta, href, featured = false } = Astro.props;
---

<article class:list={["offer", { "offer--featured": featured }]}>
  {featured && <span class="offer__ribbon">Le chouchou <span aria-hidden="true">⭐</span></span>}
  <p class="offer__tag">{tag}</p>
  <h3 class="offer__name">{name}</h3>
  <p class="offer__price">
    {price} <span>TTC</span>
  </p>
  <p class="offer__note">{note}</p>
  <ul class="offer__features">
    {features.map((f) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        {f}
      </li>
    ))}
  </ul>
  <a href={href} class:list={["offer__cta", { "offer__cta--primary": featured }]}>{cta}</a>
</article>

<style>
  .offer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--white);
    border: 1.5px solid var(--border-passive);
    border-radius: var(--radius-lg);
  }
  .offer--featured {
    border-color: var(--pop-lime);
  }
  .offer__ribbon {
    position: absolute;
    top: -0.8rem;
    left: var(--space-lg);
    padding: var(--space-xs) var(--space-md);
    background: var(--pop-lime);
    border: 1.5px solid var(--pop-lime);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .offer__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-surface-variant);
  }
  .offer__name {
    font-size: 22px;
    line-height: 30px;
    font-weight: 700;
  }
  .offer__price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.02em;
  }
  .offer__price span {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-surface-variant);
  }
  .offer__note {
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-low);
    border-radius: var(--radius);
    font-size: 13px;
    line-height: 18px;
  }
  .offer__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
    font-size: 14px;
    line-height: 20px;
  }
  .offer__features li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }
  .offer__features svg {
    flex: none;
    margin-top: 2px;
    color: var(--primary-container);
  }
  .offer__cta {
    display: block;
    padding: var(--space-sm) var(--space-md);
    text-align: center;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }
  .offer__cta:hover,
  .offer__cta:focus-visible {
    background: var(--pop-lime);
    box-shadow: var(--shadow-offset);
  }
  .offer__cta--primary {
    background: var(--primary-container);
    color: var(--white);
  }
  .offer__cta--primary:hover,
  .offer__cta--primary:focus-visible {
    background: var(--primary);
    color: var(--white);
  }
</style>