---
import Button from './Button.astro';

interface Props {
  tag: string;
  name: string;
  price: string;
  price_details : string;
  note: string;
  features: string[];
  cta: string;
  href: string;
  featured?: boolean;
}
const { tag, name, price, price_details, note, features, cta, href, featured = false } = Astro.props;
---

<article class:list={["offer", { "offer--featured": featured }]}>
  {featured && <span class="offer__ribbon">Le chouchou <span aria-hidden="true">⭐</span></span>}
  <p class="offer__tag">{tag}</p>
  <h3 class="offer__name">{name}</h3>
  <p class="offer__note">{note}</p>
  <p class="offer__price">
    <span>A partir de</span> {price} <span>{price_details}</span>
  </p>
  <ul class="offer__features">
    {features.map((f) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 6 9 17l-5-5" />
        </svg>
        {f}
      </li>
    ))}
  </ul>
  <Button href={href} variant={featured ? 'pop' : 'ghost'}>{cta}</Button>
</article>

<style>
  .offer {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--white);
    border: 1.5px solid var(--border-passive);
    border-radius: var(--radius-lg);
  }

  .offer--featured {
    border-color: var(--pop-lime);
  }

  .offer__ribbon {
    position: absolute;
    top: -0.65rem;
    left: 50%;
    padding: 0.2rem 0.75rem;
    background: var(--pop-lime);
    border: 1px solid var(--pop-lime);
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .offer__tag {
    margin: 0;
    color: var(--on-surface-variant);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 14px;
    text-transform: uppercase;
  }

  .offer__name {
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
  }

  .offer__price {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
    color: var(--primary-container);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    line-height: 40px;
    letter-spacing: -0.03em;
  }

  .offer__price span {
    display: block;
    margin-top: 0.15rem;
    color: var(--on-surface-variant);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0;
  }

  .offer__note {
    margin: 0 0 var(--space-xs);
    color: var(--on-surface-variant);
    font-size: 11px;
    line-height: 16px;
  }

  .offer__features {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.45rem;
    margin: var(--space-xs) 0 var(--space-md);
    font-size: 12px;
    line-height: 18px;
  }

  .offer__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .offer__features svg {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    color: var(--secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .offer__cta {
      transition: none;
    }
  }
</style>