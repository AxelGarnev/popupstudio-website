---
import Button from "./Button.astro";

const links = [
  { href: "/", label: "Accueil" },
  { href: "/offres-tarifs", label: "Offres & Tarifs" },
  { href: "/projets", label: "Projets" },
  { href: "/contact", label: "Contact" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="Popup Studio, retour à l’accueil">
      <span class="brand__name">Popup Studio</span>
      <span class="brand__tagline">Web éco-conçu & créatif</span>
    </a>

    <!-- FICTIF : valeur à ajuster plus tard -->
    <span class="eco-badge">
      <span class="eco-badge__dot" aria-hidden="true"></span>
      Éco-index A • 0,08 g CO₂
    </span>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="visually-hidden">Ouvrir le menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <nav id="main-nav" class="nav" aria-label="Navigation principale">
      <ul class="nav__list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="nav__link"
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <Button href="/contact" variant="pop">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
          <path d="M14 3v6h6M9 13h6M9 17h6" />
        </svg>
        Demander un devis <span aria-hidden="true">🚀</span>
      </Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.getElementById("main-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface);
    border-bottom: 1.5px solid var(--border-passive);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .brand__tagline {
    font-size: 11px;
    font-weight: 600;
    color: var(--on-surface-variant);
  }

  .eco-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) 0.625rem;
    background: var(--pop-lime);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 16px;
    white-space: nowrap;
  }
  .eco-badge__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--primary-container);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--gutter);
    margin-left: auto;
  }
  .nav__list {
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-xs);
    background: var(--surface-low);
    border-radius: var(--radius-full);
  }
  .nav__link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--on-surface-variant);
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link[aria-current="page"] {
    background: var(--surface-high);
    color: var(--ink);
  }

  .btn-pop {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--pop-lime);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn-pop:hover,
  .btn-pop:focus-visible { box-shadow: var(--shadow-offset); }
  .btn-pop:active { transform: translate(2px, 2px); box-shadow: none; }

  .menu-toggle {
    display: none;
    margin-left: auto;
    padding: var(--space-sm);
    background: transparent;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    color: var(--ink);
  }

  

  @media (max-width: 64rem) {
    .eco-badge { display: none; }
    .menu-toggle { display: block; }
    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-md) var(--margin) var(--space-lg);
      background: var(--surface);
      border-bottom: 1.5px solid var(--ink);
    }
    .nav.is-open { display: flex; }
    .nav__list { flex-direction: column; background: none; padding: 0; }
    .nav__link { padding: var(--space-sm) var(--space-md); }
    .btn-pop { justify-content: center; }
  }
</style>